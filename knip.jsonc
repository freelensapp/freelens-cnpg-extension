{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",

  "entry": [
    "out/{main,preload}/index.js!",
    "src/main/index.ts",
    "src/renderer/index.tsx",
    "src/**/*.{test,spec}.{ts,tsx}",
    "test/**/*.{ts,tsx}"
  ],
  "project": ["*.{js,mjs,ts}", "out/**/*.js!", "src/**/*.{ts,tsx,sass,scss}"],

  "ignoreBinaries": ["electron-rebuild"],
  "ignoreDependencies": [
    // Build-only plugins of the electron-vite and vitest configs: Knip 6.35+
    // executes those configs to find them and trips on the ESM-only
    // @vitejs/plugin-react, so the configs stay unread (below) and the plugins
    // are listed here instead.
    "@babel/plugin-proposal-decorators",
    "@vitejs/plugin-react",
    "vite-plugin-sass-dts"
  ],

  "typescript": {
    "config": ["tsconfig.json"]
  },
  // See ignoreDependencies: the electron-vite and vitest configs import
  // @vitejs/plugin-react and cannot be executed by Knip's config loader.
  "electron-vite": false,
  "vite": false,
  "vitest": false,

  "exclude": ["exports"]
}
